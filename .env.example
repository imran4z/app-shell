# App Shell - environment. Copy to .env (`just env` does this).
# The app calls load_dotenv(override=True): this file is CANONICAL for
# secrets. Never define infrastructure names here that compose injects
# (APPSHELL_POSTGRES_HOST stays compose-only - see BLUEPRINT.md §1).

# -- LLM --------------------------------------------------------------
# Required for any agent/assistant feature. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=
# Default model for agents (see MODEL_PRICES in observability/llm_client.py).
APPSHELL_MODEL=claude-opus-5

# -- Postgres (dev lane defaults match compose.yaml) -----------------
POSTGRES_USER=appshell
POSTGRES_PASSWORD=appshell
POSTGRES_DB=appshell
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -- Ports (host side; change if 5432/8765 are already taken) --------
# APPSHELL_DB_PORT=5432   # host port mapped to the Postgres container
# APPSHELL_PORT=8765      # host port mapped to the app container
# If you change APPSHELL_DB_PORT, set POSTGRES_PORT to match so the dev
# lane (local `just api`) connects to the right place.

# -- Misc -------------------------------------------------------------
APPSHELL_LOG_LEVEL=INFO
# The assistant's mutating tools pause for human approval. Set to "off"
# to let them run unattended (not recommended).
APPSHELL_ASSISTANT_APPROVALS=on
